<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  claude-devlog launchd schedule
  installed to ~/Library/LaunchAgents/com.user.devlog.plist
  load: launchctl load -w ~/Library/LaunchAgents/com.user.devlog.plist

  默认每天 22:00 触发；通常错过（合盖中），sleepwatcher 会先一步触发，
  这个 launchd entry 主要负责醒来时补跑 launchd catch-up。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.devlog</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/bin/devlog-daily.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>22</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.devlog/_launchd.out</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.devlog/_launchd.err</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
